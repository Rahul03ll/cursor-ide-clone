{
  "name": "python-ide",
  "version": "1.0.0",
  "description": "AI-Powered Python IDE - Desktop Application",
  "main": "public/electron.js",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^27.5.2",
    "@types/jszip": "^3.4.1",
    "@types/node": "^16.18.11",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "axios": "^1.2.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.53.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-resizable-panels": "^0.0.36",
    "react-router-dom": "^6.6.2",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.2.4",
    "typescript": "^4.9.4",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@craco/craco": "^5.9.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^39.1.1",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "identity-obj-proxy": "^3.0.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "wait-on": "^7.2.0",
    "worker-loader": "^3.0.8"
  },
  "resolutions": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none PORT=3001 craco start\" \"wait-on http://localhost:3001 && electron .\"",
    "build": "craco build",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "build-app": "npm run build && electron-builder",
    "test": "craco test --transformIgnorePatterns \"node_modules/(?!axios|@monaco-editor)/\"",
    "eject": "react-scripts eject"
  },
  "build": {
    "appId": "com.pythonide.app",
    "productName": "Python IDE",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js",
      "public/preload.js"
    ],
    "extraResources": [
      {
        "from": "node_modules/monaco-editor/min/vs",
        "to": "monaco-editor/min/vs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/logo512.png",
      "certificateFile": null,
      "certificatePassword": null,
      "asar": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo512.png"
    },
    "forceCodeSigning": false
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
