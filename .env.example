# AI Configuration - Choose your preferred AI provider(s)

# ===== GOOGLE GEMINI API (FREE) =====
# Get your FREE API key from: https://aistudio.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# ===== OPENAI API =====
# Get your API key from: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# ===== OPENROUTER API (Alternative to OpenAI) =====
# Get your API key from: https://openrouter.ai/keys
# Supports multiple models: GPT-4, Claude, Llama, etc.
REACT_APP_OPENROUTER_API_KEY=your_openrouter_api_key_here
REACT_APP_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ===== SITE CONFIGURATION (for OpenRouter rankings) =====
REACT_APP_SITE_URL=http://localhost:3001
REACT_APP_SITE_NAME=AI Python IDE

# ===== MODEL SELECTION =====
# Default model to use (options: gemini, gpt-4o, gpt-4o-mini, gpt-5, claude-3.5-sonnet)
REACT_APP_DEFAULT_MODEL=gemini

# ===== NOTES =====
# • Gemini API is FREE and requires no credit card
# • OpenAI API requires payment but offers GPT models
# • OpenRouter provides access to multiple models through one API
# • You can configure multiple providers and switch between them in the app
# • Restart the development server after updating the .env file
